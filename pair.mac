/* Appendix B of Espanol and Revenga, PRE 67, 026705 (2003), for one
pair of particles (i, k) in three dimensions with explicit components.

Every pair has its own Wiener matrix dW and scalar dV, and its noise
acts on i and k with opposite signs, so the full matrix M is a sum of
pair blocks. It is enough to compute one block in the variables
x = (v_i, v_k, S_i, S_k).

maxima -b pair.mac
*/

n: 3$
assume(kB > 0, m > 0, a > 0, b > 0, kappa > 0, f > 0, Ti > 0, Tk > 0)$
e: matrix([e1], [e2], [e3])$
vi: matrix([vi1], [vi2], [vi3])$
vk: matrix([vk1], [vk2], [vk3])$
v: vi - vk$
unit(ex):= ratsimp(ratsubst(1 - e1^2 - e2^2, e3^2, expand(ex)))$
dot(p, q):= sum(p[r, 1]*q[r, 1], r, 1, n)$

/* eq. (49) */
dW: genmatrix(lambda([r, c], w[r, c]), n, n)$
tr: sum(dW[r, r], r, 1, n)$
dWbar: (dW + transpose(dW))/2 - tr/3*ident(n)$
X: A*dWbar + B*tr/3*ident(n)$
Xev: sum(sum(X[r, c]*e[r, 1]*v[c, 1], r, 1, n), c, 1, n)$
dvi: X . e/m$
dSi: (-Xev/2 + C*dV)/Ti$
dSk: (-Xev/2 - C*dV)/Tk$
xi: append(makelist(dvi[r, 1], r, 1, n), makelist(-dvi[r, 1], r, 1, n), [dSi, dSk])$
nx: length(xi)$

/* Ito rules (53): independent increments with unit variance per dt */
noises: append(create_list(w[r, c], r, 1, n, c, 1, n), [dV])$
ito(ex):= block([ex: expand(ex)], lsum(coeff(ex, s, 2), s, noises))$
Q: genmatrix(lambda([r, c], ito(xi[r]*xi[c])), nx, nx)$
M: Q/(2*kB)$

/* (B3), diagonal velocity block: should be zero */
B3: genmatrix(lambda([r, c], A^2/2*(kron_delta(r, c) + e[r, 1]*e[c, 1])
    + (B^2 - A^2)/3*e[r, 1]*e[c, 1]), n, n)$
unit(m^2*submatrix(4, 5, 6, 7, 8, Q, 4, 5, 6, 7, 8) - B3);

/* amplitudes (62) written with a, b of (60) and c = 2 kappa F/(d_i d_k) */
amp: [A = sqrt(8*kB*a*Ti*Tk/(Ti + Tk)), B = sqrt(12*kB*b*Ti*Tk/(Ti + Tk)),
  C = sqrt(4*kappa*kB*f*Ti*Tk)]$
M: ratsimp(subst(amp, M))$
Q: ratsimp(subst(amp, Q))$

/* drift M dS/dx + kB dM/dx, with dT/dS = T/C_s */
xv: [vi1, vi2, vi3, vk1, vk2, vk3]$
D(ex, c):= if c <= 6 then diff(ex, xv[c])
  else if c = 7 then Ti/Csi*diff(ex, Ti) else Tk/Csk*diff(ex, Tk)$
dSdx: append(makelist(0, 6), [1, 1])$
drift: makelist(sum(M[r, c]*dSdx[c] + kB*D(M[r, c], c), c, 1, nx), r, 1, nx)$

/* eq. (63), contribution of the pair (i, k) */
d: Ti*Tk/(Ti + Tk)^2*(kB/Csi + kB/Csk)$
ev: dot(e, v)$
vv: dot(v, v)$
mdv: -(1 - d)*(a*v + (a/3 + b)*ev*e)$
TdS: 1/2*(1 - d - Tk/(Ti + Tk)*kB/Csi)*(a*vv + (a/3 + b)*ev^2)
  - 2*kB/m*Ti*Tk/(Ti + Tk)*(10/3*a + b)
  - 2*kappa*f*(Ti - Tk) - 2*kappa*kB/Csi*f*Tk$
makelist(unit(m*drift[r] - mdv[r, 1]), r, 1, n);
makelist(unit(m*drift[r + n] + mdv[r, 1]), r, 1, n);
unit(Ti*drift[7] - TdS);

/* energy: E = m (v_i^2 + v_k^2)/2 + E(S_i) + E(S_k), Ito formula (65) */
dE: m*sum(vi[r, 1]*drift[r] + vk[r, 1]*drift[r + n], r, 1, n)
  + Ti*drift[7] + Tk*drift[8]
  + (m*sum(Q[r, r], r, 1, 2*n) + Ti/Csi*Q[7, 7] + Tk/Csk*Q[8, 8])/2$
unit(dE);
