/* Linear modes of deterministic 3D SDPD about the perfect fcc lattice
(density 1, Wendland C2 kernel; set kernel: lucy for Lucy). A plane wave along y with amplitudes of
displacement U, velocity V and entropy s. With rho = R_i - R_j the
lattice sums are exact; no continuum integral is used.

  density   dd = -i U_y A1,            A1 = sum F rho_y sin(k rho_y)
  T/d       pi = ((2/3) s - (1/3) dd/d0)/d0
  pressure  dV/dt = -i pi A1 e_y + (2/d0) M U,
            M_ab = sum (1 - cos(k rho_y)) (F delta_ab + F' rho_a rho_b/rho)
  friction  dV/dt = -G V,
            G_ab = sum (1 - cos(k rho_y)) F (a delta_ab + c e_a e_b)/d0^2
  heat      ds/dt = -(4 kappa/(3 d0^2)) B (dd/d0 + s),
            B = sum (1 - cos(k rho_y)) F
with a = 5 eta/3 - zeta, c = a/3 + 16 zeta/3 + 10 eta/9. Shear (x) is
(U, V); sound and heat (y) are (U, V, i s) and real. */

linel: 300$
fpprec: 20$
if not member(kernel, [lucy]) then kernel: wendland$
if kernel = lucy then (
  W(r):= float(105/(16*%pi*h^3))*(1 + 3*r/h)*(1 - r/h)^3,
  F(r):= float(315/(4*%pi*h^5))*(1 - r/h)^2,
  dF(r):= float(-630/(4*%pi*h^6))*(1 - r/h))
else (
  W(r):= float(21/(2*%pi*h^3))*(1 + 4*r/h)*(1 - r/h)^4,
  F(r):= float(210/(%pi*h^5))*(1 - r/h)^3,
  dF(r):= float(-630/(%pi*h^6))*(1 - r/h)^2)$

/* fcc points A/2 (i, j, l) with i + j + l even, A = 4^(1/3) */
sites(h):= block([A: float(4^(1/3)), m, out: []],
  m: ceiling(2*h/A),
  for i: -m thru m do for j: -m thru m do for l: -m thru m do
    if evenp(i + j + l) then block([r: float(A/2*sqrt(i^2 + j^2 + l^2))],
      if r < h then out: cons([A/2*i, A/2*j, A/2*l, r], out)),
  out)$

modes(h, k, eta, zeta, kappa):= block([S: sites(h), d0: 0, A1: 0, B: 0,
    Mxx: 0, Myy: 0, Gxx: 0, Gyy: 0, a, c],
  a: 5*eta/3 - zeta, c: a/3 + 16*zeta/3 + 10*eta/9,
  for s in S do block([x: s[1], y: s[2], r: s[4], cs, sn],
    d0: d0 + W(r),
    if r > 0 then (
      cs: 1 - cos(k*y), sn: sin(k*y),
      A1: A1 + F(r)*y*sn,
      B: B + cs*F(r),
      Mxx: Mxx + cs*(F(r) + dF(r)*x^2/r),
      Myy: Myy + cs*(F(r) + dF(r)*y^2/r),
      Gxx: Gxx + cs*F(r)*(a + c*x^2/r^2),
      Gyy: Gyy + cs*F(r)*(a + c*y^2/r^2))),
  Gxx: Gxx/d0^2, Gyy: Gyy/d0^2,
  [d0, matrix([0, 1], [2*Mxx/d0, -Gxx]),
   matrix([0, 1, 0],
          [2*Myy/d0 - A1^2/(3*d0^3), -Gyy, 2*A1/(3*d0)],
          [4*kappa*B*A1/(3*d0^3), 0, -4*kappa*B/(3*d0^2)])])$

/* continuum limit: small k at fixed h gives the transport coefficients */
block([r: modes(3.0, 1e-3, 1, 0, 1), k: 1e-3],
  print("d0", r[1]),
  print("shear rate/k^2 ->", -r[2][2, 2]/k^2, "(eta)"),
  print("longitudinal rate/k^2 ->", -r[3][2, 2]/k^2, "(4 eta/3)"),
  print("heat rate/k^2 ->", -r[3][3, 3]/k^2, "(kappa/c_v, c_v = 3/2)"),
  print("c^2 ->", (r[3][2, 1] - r[3][2, 3]*r[3][3, 1]/r[3][3, 3])/(-k^2), "(isothermal 1)"),
  print("elastic shear 2 Mxx/d0/k^2 ->", r[2][2, 1]/k^2))$

/* write k h, d0 and the matrices for the runs to compare against */
with_stdout(concat("lattice3.", kernel), for h in [3, 4] do
  for rows in [8, 12, 16, 24, 32, 48, 64] do
    block([A: float(4^(1/3)), k, P],
      k: float(2*%pi/(rows*A/2)),
      for p in [[1, 0, 1], [0.5, 0, 1]] do (
        P: modes(float(h), k, p[1], p[2], p[3]),
        print(h, rows, k, p[1], p[2], p[3], P[1],
          P[2][2, 1], P[2][2, 2],
          P[3][2, 1], P[3][2, 2], P[3][2, 3], P[3][3, 1], P[3][3, 3]))))$
