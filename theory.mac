/* linear response of the SDPD operators for the Lucy kernel, h = 1 */

W2(r):= 5/%pi*(1 + 3*r)*(1 - r)^3$
F2(r):= 60/%pi*(1 - r)^2$
W3(r):= 105/(16*%pi)*(1 + 3*r)*(1 - r)^3$
F3(r):= 315/(4*%pi)*(1 - r)^2$

nu2(k):= 2/k^2*quad_qags((1 - bessel_j(0, k*r))*F2(r)*2*%pi*r, r, 0, 1)[1]$
c2(k):= sqrt(quad_qags(bessel_j(0, k*r)*W2(r)*2*%pi*r, r, 0, 1)[1])$
g(a):= ''(integrate((1 - cos(a*u))*(3 - u^2)/2, u, -1, 1))$
nu3(k):= 2*%pi/k^2*quad_qags(5/3*r^2*F3(r)*g(k*r), r, 0, 1)[1]$
c3(k):= sqrt(quad_qags(sin(k*r)/(k*r)*W3(r)*4*%pi*r^2, r, 0, 1)[1])$

lh: makelist(0.8*1.025^i, i, 0, 120)$
with_stdout("theory2", for l in lh do
  block([k: float(2*%pi/l)], print(l, float(nu2(k)), float(c2(k)))))$
with_stdout("theory3", for l in lh do
  block([k: float(2*%pi/l)], print(l, float(nu3(k)), float(c3(k)))))$
