batch("pair3.mac")

n:3
assume(kB > 0,m > 0,a > 0,b > 0,kappa > 0,f > 0,Ti > 0,Tk > 0)
gradef(Ti,Si,Ti/Ci)
gradef(Tk,Sk,Tk/Ck)
gradef(Ei,Si,Ti)
gradef(Ek,Sk,Tk)
unit(ex):=ratsimp(subst(e[n]^2 = 1-sum(e[c]^2,c,1,n-1),expand(ex)))
v[c]:=vi[c]-vk[c]
ve:sum(e[c]*v[c],c,1,n)
vv:sum(v[c]^2,c,1,n)
tr:sum(w[c,c],c,1,n)
X[c,d]:=A*((w[c,d]+w[d,c])/2-(kron_delta(c,d)*tr)/n)+(B*kron_delta(c,d)*tr)/n
dv[c]:=sum(X[c,d]*e[d],d,1,n)/m
Xev:sum(sum(X[c,d]*e[c]*v[d],c,1,n),d,1,n)
x:append(makelist(vi[c],c,1,n),makelist(vk[c],c,1,n),[Si,Sk])
dx:append(makelist(dv[c],c,1,n),makelist(-dv[c],c,1,n),
          [((-Xev)/2+C*dV)/Ti,((-Xev)/2-C*dV)/Tk])
nx:length(x)
ito(ex):=block([ex:expand(ex)],
    sum(sum(coeff(ex,w[c,d],2),c,1,n),d,1,n)+coeff(ex,dV,2))
Q:genmatrix(lambda([r,s],ito(dx[r]*dx[s])),nx,nx)
B3:unit(genmatrix(lambda([r,s],
                         m^2*Q[r,s]-(A^2/2)*(kron_delta(r,s)+e[r]*e[s])
                                   +((-(B^2-A^2))/n)*e[r]*e[s]),n,n))
                                  [ 0  0  0 ]
                                  [         ]
                                  [ 0  0  0 ]
                                  [         ]
                                  [ 0  0  0 ]
Q:ratsimp(subst([A^2 = (8*kB*a*Ti*Tk)/(Ti+Tk),B^2 = (12*kB*b*Ti*Tk)/(Ti+Tk),
                 C^2 = 4*kappa*kB*f*Ti*Tk],Q))
M:Q/(2*kB)
S:Si+Sk
drift:makelist(sum(M[r,s]*diff(S,x[s])+kB*diff(M[r,s],x[s]),s,1,nx),r,1,nx)
P:unit(makelist(drift[c]+drift[n+c],c,1,n))
                                   [0, 0, 0]
d:((Ti*Tk)/(Ti+Tk)^2)*(kB/Ci+kB/Ck)
vdrift:unit(makelist(m*drift[c]+(1-d)*(a*v[c]+(a/3+b)*ve*e[c]),c,1,n))
                                   [0, 0, 0]
Sdrift:unit(Ti*drift[2*n+1]-(1/2)*(1-d+(((-Tk)/(Ti+Tk))*kB)/Ci)
                                 *(a*vv+(a/3+b)*ve^2)
                           +((((2*kB)/m)*Ti*Tk)/(Ti+Tk))*((10/3)*a+b)
                           +2*kappa*f*(Ti-Tk)+((2*kappa*kB)/Ci)*f*Tk)
                                       0
E:(m/2)*sum(vi[c]^2+vk[c]^2,c,1,n)+Ei+Ek
dE:unit(sum(diff(E,x[r])*drift[r],r,1,nx)
         +(1/2)*sum(sum(diff(E,x[r],1,x[s],1)*Q[r,s],r,1,nx),s,1,nx))
                                       0
