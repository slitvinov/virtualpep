/* Appendix B of Espanol and Revenga, PRE 67, 026705 (2003), two dimensions,
for one pair of particles (i, k) with explicit components.

Every pair has its own Wiener matrix dW and scalar dV, and its noise
acts on i and k with opposite signs, so the matrix M is a sum of pair
blocks in the variables x = (v_i, v_k, S_i, S_k).

maxima -b pair2.mac
*/

n: 2$
assume(kB > 0, m > 0, a > 0, b > 0, kappa > 0, f > 0, Ti > 0, Tk > 0)$
e: genmatrix(lambda([r, c], ee[r]), n, 1)$
vi: genmatrix(lambda([r, c], ui[r]), n, 1)$
vk: genmatrix(lambda([r, c], uk[r]), n, 1)$
v: vi - vk$
unit(ex):= ratsimp(ratsubst(1 - sum(ee[r]^2, r, 1, n - 1), ee[n]^2, expand(ex)))$
dot(p, q):= sum(p[r, 1]*q[r, 1], r, 1, n)$

/* eq. (49) */
dW: genmatrix(lambda([r, c], w[r, c]), n, n)$
tr: sum(dW[r, r], r, 1, n)$
dWbar: (dW + transpose(dW))/2 - tr/n*ident(n)$
X: A*dWbar + B*tr/n*ident(n)$
Xev: sum(sum(X[r, c]*e[r, 1]*v[c, 1], r, 1, n), c, 1, n)$
dvi: X . e/m$
dSi: (-Xev/2 + C*dV)/Ti$
dSk: (-Xev/2 - C*dV)/Tk$
xi: append(makelist(dvi[r, 1], r, 1, n), makelist(-dvi[r, 1], r, 1, n), [dSi, dSk])$
nx: length(xi)$

/* Ito rules (53): independent increments with unit variance per dt */
noises: append(create_list(w[r, c], r, 1, n, c, 1, n), [dV])$
ito(ex):= block([ex: expand(ex)], lsum(coeff(ex, s, 2), s, noises))$
Q: genmatrix(lambda([r, c], ito(xi[r]*xi[c])), nx, nx)$

/* (B3), diagonal velocity block */
B3: genmatrix(lambda([r, c], A^2/2*(kron_delta(r, c) + e[r, 1]*e[c, 1])
    + (B^2 - A^2)/n*e[r, 1]*e[c, 1]), n, n)$
unit(m^2*genmatrix(lambda([r, c], Q[r, c]), n, n) - B3);

/* amplitudes (62) written with a, b of (60) and c = 2 kappa F/(d_i d_k) */
amp: [A = sqrt(8*kB*a*Ti*Tk/(Ti + Tk)), B = sqrt(8*kB*b*Ti*Tk/(Ti + Tk)),
  C = sqrt(4*kappa*kB*f*Ti*Tk)]$
Q: ratsimp(subst(amp, Q))$
M: Q/(2*kB)$

/* drift M dS/dx + kB dM/dx, with dT/dS = T/C_s */
xv: append(makelist(ui[r], r, 1, n), makelist(uk[r], r, 1, n))$
D(ex, c):= if c <= 2*n then diff(ex, xv[c])
  else if c = 2*n + 1 then Ti/Csi*diff(ex, Ti) else Tk/Csk*diff(ex, Tk)$
dSdx: append(makelist(0, 2*n), [1, 1])$
drift: makelist(sum(M[r, c]*dSdx[c] + kB*D(M[r, c], c), c, 1, nx), r, 1, nx)$

/* eq. (63), contribution of the pair (i, k) */
d: Ti*Tk/(Ti + Tk)^2*(kB/Csi + kB/Csk)$
ev: dot(e, v)$
vv: dot(v, v)$
mdv: -(1 - d)*(a*v + (b)*ev*e)$
TdS: 1/2*(1 - d - Tk/(Ti + Tk)*kB/Csi)*(a*vv + (b)*ev^2)
  - 2*kB/m*Ti*Tk/(Ti + Tk)*(2*a + b)
  - 2*kappa*f*(Ti - Tk) - 2*kappa*kB/Csi*f*Tk$
makelist(unit(m*drift[r] - mdv[r, 1]), r, 1, n);
makelist(unit(m*drift[r + n] + mdv[r, 1]), r, 1, n);
unit(Ti*drift[2*n + 1] - TdS);

/* energy: E = m (v_i^2 + v_k^2)/2 + E(S_i) + E(S_k), Ito formula (65) */
dE: m*sum(vi[r, 1]*drift[r] + vk[r, 1]*drift[r + n], r, 1, n)
  + Ti*drift[2*n + 1] + Tk*drift[2*n + 2]
  + (m*sum(Q[r, r], r, 1, 2*n) + Ti/Csi*Q[2*n + 1, 2*n + 1] + Tk/Csk*Q[2*n + 2, 2*n + 2])/2$
unit(dE);
