/* shear matrices of lattice.mac for the points of run.sh in 3D, eta = 10 */
batchload("lattice.mac")$
linel: 300$
latt(file, eta, cols):= with_stdout(file, for h in [3, 4] do
  for lh in [1, 1.25, 1.5, 2, 2.5, 3, 4, 6, 8, 12, 16] do
    block([row: 0.7937005, rows, k],
      rows: floor(lh*h/row + 0.5),
      k: float(2*%pi/(rows*row)),
      apply('print, append([h, rows*row/h, k], cols(modes(float(h), k, eta, 0, 0))))))$
latt("latt3.raw", 10, lambda([P], [P[2][2, 1], P[2][2, 2]]))$
latt("latt3s.raw", 0.2, lambda([P],
  [P[3][2, 1], P[3][2, 2], P[3][2, 3], P[3][3, 1], P[3][3, 3]]))$
